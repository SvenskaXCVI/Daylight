{
  "name": "daylight-mobile",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:web": "node scripts/prepare-web.mjs",
    "ios:add": "npm run build:web && cap add ios",
    "ios:sync": "npm run build:web && cap sync ios",
    "ios:open": "cap open ios",
    "ios:assets": "capacitor-assets generate --ios",
    "release:check": "node scripts/app-store-check.mjs",
    "test": "node tests/production-safety.test.mjs && npm run build:web && npm run release:check"
  },
  "dependencies": {
    "@capacitor/core": "6.2.1",
    "@capacitor/ios": "6.2.1"
  },
  "devDependencies": {
    "@capacitor/assets": "3.0.5",
    "@capacitor/cli": "6.2.1"
  }
}
